<resources>
    <!-- Introduction detail message shown in face education [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_education_message">在下一界面，请将手机举至与眼睛齐平</string>

    <!-- Message on the face enrollment introduction page that provides information about glasses. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_info_glasses">如果您平时戴眼镜，设置过程中可如常佩戴。</string>

    <!-- Introduction detail message shown in face enrollment dialog [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_enroll_introduction_message">刷脸解锁手机</string>

    <!-- Settings suggestion alert body text for re-enrolling a face. [CHAR LIMIT=300] -->
    <string name="security_settings_face_enroll_improve_face_alert_body">请删除您当前的脸部模型以重新设置人脸解锁。\n\n系统会安全地永久删除您的脸部模型。\n\n脸部模型删除后，如需解锁手机，您将需要使用数字密码、解锁图案或混合密码。</string>

    <!-- Settings suggestion alert body text for re-enrolling a face. [CHAR LIMIT=300] -->
    <string name="security_settings_face_enroll_improve_face_alert_body_fingerprint">请删除您当前的脸部模型以重新设置人脸解锁。\n\n系统会安全地永久删除您的脸部模型。\n\n脸部模型删除后，如需解锁手机，您将需要使用指纹、数字密码、解锁图案或混合密码。</string>

    <!-- Text shown on the details of a toggle which disables/enables face unlock, depending if the user's eyes are open. [CHAR LIMIT=70] -->
    <string name="security_settings_face_settings_require_attention_details">必须睁开双眼才能解锁手机。为获得最佳效果，请在解锁手机时取下太阳镜。</string>

    <!-- Text shown in face settings explaining what your face can be used for. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_settings_footer">您可以通过刷脸来解锁手机。\n\n请注意：\n同一时间只能设置有 1 张面孔。如需添加其他面孔，请先删除当前的面孔。\n\n目视手机可能会让手机在您并未要求的情况下解锁。\n\n如果有人将手机对准您的脸，手机可能会解锁。\n\n长相与您非常相似的人（例如您的同卵兄弟姐妹）可能也能解锁您的手机。</string>

    <!-- Text shown in face settings explaining what your face can be used for. Used when attention checking is not supported. [CHAR LIMIT=NONE] -->
    <string name="security_settings_face_settings_footer_attention_not_supported">您可以通过刷脸来解锁手机。\n\n请注意：\n同一时间只能设置有 1 张面孔。如需添加其他面孔，请先删除当前的面孔。\n\n目视手机可能会让手机在您并未要求的情况下解锁。\n\n如果有人将手机对准您的脸，即使您闭上眼睛，手机也可能会解锁。\n\n长相与您非常相似的人（例如您的同卵兄弟姐妹）可能也能解锁您的手机。</string>

    <!-- Introduction title shown in face enrollment education screen for accessibility [CHAR LIMIT=50] -->
    <string name="security_settings_face_enroll_education_title_accessibility">如何设置人脸解锁</string>
</resources>
